# Environment Configuration for Network Toolbox

# Django Settings
SECRET_KEY=django-insecure-change-me-in-production
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1,nt-django

# Database Settings
DB_HOST=postgres
DB_PORT=5432
DB_NAME=network_toolbox
DB_USER=postgres
DB_PASSWORD=postgres123

# Timezone
TZ=Asia/Taipei

# Redis Settings
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0

# NAS Mount Path for Jenkins Storage
# If NAS is mounted at /mnt/mdt, uncomment the volume mount in docker-compose.yml
NAS_MOUNT_PATH=/mnt/mdt

# Jenkins API Configuration (Optional)
# JENKINS_DEFAULT_USERNAME=admin
# JENKINS_DEFAULT_PASSWORD=your_jenkins_password

# CORS Settings
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost
